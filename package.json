{
  "name": "payshield-ai",
  "version": "1.0.0",
  "private": true,
  "description": "PayShield AI - Autonomous Fraud Intelligence",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "echo 'Build complete'",
    "start:backend": "cd backend && npm install && npm run dev",
    "start:ml": "cd ml-engine && pip install -r requirements.txt && python main.py",
    "start:frontend": "cd frontend && npm install && npm run dev",
    "start:sim": "cd data-simulator && python stream_generator.py",
    "blockchain:node": "cd Blockchain && npx hardhat node",
    "blockchain:deploy": "cd Blockchain && npx hardhat run scripts/deploy.js --network localhost",
    "init:all": "cd backend && npm install && cd ../frontend && npm install"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@google/generative-ai": "^0.24.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.54.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.54.0",
    "@opentelemetry/resources": "^1.27.0",
    "@opentelemetry/sdk-node": "^0.54.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "axios": "^1.6.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "ethers": "^6.9.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "imap": "^0.8.19",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.6.9",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.8",
    "pg": "^8.11.3",
    "pino": "^9.3.2",
    "prom-client": "^15.1.3",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  }
}
